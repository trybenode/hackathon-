# Merge these into existing backend Vercel settings only AFTER GPU/storage/worker acceptance.
# This is not a complete replacement for database/auth/email/production settings.
HISTORY_AI_ENABLED=true
HISTORY_AI_BASE_URL=https://YOUR_GPU_GATEWAY_DOMAIN
HISTORY_AI_API_KEY=REPLACE_WITH_SAME_GATEWAY_SECRET
HISTORY_EXTERNAL_WORKER=true
HISTORY_AUDIO_STORAGE=s3
HISTORY_AUDIO_BUCKET=YOUR_PRIVATE_AUDIO_BUCKET
AWS_REGION=YOUR_BUCKET_REGION
AWS_ACCESS_KEY_ID=REPLACE_WITH_SERVER_CREDENTIAL
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SERVER_SECRET
# AWS_ENDPOINT_URL_S3=https://YOUR_S3_COMPATIBLE_ENDPOINT
RUN_HISTORY_WORKER=false
HISTORY_SPEECH_ENABLED=false
EXPIRY_SWEEP_SECONDS=0
