# Shared services-project settings; only NEXT_PUBLIC_API_BASE_URL is browser-visible.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# BACKEND_URL is injected by the binding. Do not set it yourself.
# API_PROXY_ORIGIN is only for standalone/container deployments.
INTERNAL_PROXY_SECRET=<shared-private-proxy-secret>
ENABLE_EXPERIMENTAL_COREPACK=1
# Review Vercel's authenticated ingress chain before enabling client IP forwarding.
PROXY_TRUSTED_HOPS=0
