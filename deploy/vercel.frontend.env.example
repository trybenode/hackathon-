# Frontend project settings; only NEXT_PUBLIC_API_BASE_URL is browser-visible.
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_ORIGIN=https://your-backend.vercel.app
INTERNAL_PROXY_SECRET=<same-proxy-secret-as-backend>
ENABLE_EXPERIMENTAL_COREPACK=1
# Review Vercel's authenticated ingress chain before enabling client IP forwarding.
PROXY_TRUSTED_HOPS=0
