# Backend project environment; replace placeholders in Vercel, never commit actual secrets.
ENVIRONMENT=production
DEPLOYMENT_MODE=serverless
DATABASE_URL=postgresql://user:password@your-neon-pooler-host/trust?sslmode=require
# Used only by the separate migration operation, never during function requests.
MIGRATION_DATABASE_URL=postgresql://user:password@your-neon-direct-host/trust?sslmode=require
REDIS_URL=rediss://default:password@your-upstash-host:6379/0
FRONTEND_BASE_URL=https://your-frontend.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app
CREDENTIAL_SIGNING_SECRET=<generate-a-separate-32-byte-secret>
INTERNAL_PROXY_SECRET=<same-proxy-secret-in-backend-and-frontend>
RESEND_API_KEY=<your-key>
RESEND_FROM=Trust <login@your-verified-domain>
SMS_PROVIDER=disabled
RUN_HISTORY_WORKER=false
HISTORY_AI_ENABLED=false
HISTORY_SPEECH_ENABLED=false
EXPIRY_SWEEP_SECONDS=0
