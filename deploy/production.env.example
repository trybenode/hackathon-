# Copy into your provider secret store; this example contains no deployable secrets.
ENVIRONMENT=production
DATABASE_URL=postgresql://user:password@your-postgres-host/trust?sslmode=require
# Use an unpooled direct PostgreSQL URL for coordinated migrations.
MIGRATION_DATABASE_URL=postgresql://user:password@your-direct-postgres-host/trust?sslmode=require
REDIS_URL=rediss://user:password@your-redis-host:6379/0
FRONTEND_BASE_URL=https://your-frontend-domain
CORS_ORIGINS=https://your-frontend-domain
CREDENTIAL_SIGNING_SECRET=<generate-at-least-32-random-characters>
INTERNAL_PROXY_SECRET=<same-random-secret-in-api-and-frontend>
RESEND_API_KEY=<your-key>
RESEND_FROM=Trust <login@your-verified-domain>
SMS_PROVIDER=disabled
RUN_HISTORY_WORKER=true
HISTORY_AUDIO_DIR=/var/lib/trust/history
HISTORY_AI_ENABLED=false
HISTORY_SPEECH_ENABLED=false
# Frontend: browser URL is fixed into the bundle at build time.
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_ORIGIN=http://your-private-backend-host:8000
# Leave 0 until your managed edge's forwarding chain is verified. See deployment guide.
PROXY_TRUSTED_HOPS=0
