# Shared configuration. Copy to .env and fill in.

# Postgres — your database connection (Neon in deployed environments)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
DATABASE_URL_POOLED=

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Transactional email. Without a key, login codes are written to the API log.
RESEND_API_KEY=
# Must be a verified Resend domain, or its shared onboarding sender.
RESEND_FROM=Trust Infrastructure <onboarding@resend.dev>

# HMAC key used to sign portable worker credential bundles (minimum 32 chars).
CREDENTIAL_SIGNING_SECRET=

# Shared MVP credential for B2B platform API calls using X-API-Key.
PLATFORM_API_KEY=

# For local development, put machine-specific overrides in .env.local, e.g.
#   DATABASE_URL=postgresql+asyncpg://you@localhost:5432/trust_dev

# Payscrow escrow. Without a key, a local stand-in holds job payments.
# Sandbox keys come from payscrow.dev; production is https://api.payscrow.net.
PAYSCROW_API_KEY=
PAYSCROW_BASE_URL=https://api.payscrow.dev
# Dashboard -> Access & API -> Webhook Signing Secret.
PAYSCROW_WEBHOOK_SECRET=
# Public HTTPS address of POST /api/v1/webhooks/payscrow (a tunnel locally).
PAYSCROW_WEBHOOK_URL=
# Share of Payscrow's charge the worker bears, 0-100 (0: the client pays it).
PAYSCROW_MERCHANT_CHARGE_PERCENTAGE=0
# Days after a job is marked complete before an unconfirmed client is reminded.
# Funds never release on a timer: only the client's escrow code releases them.
ESCROW_CONFIRMATION_REMINDER_DAYS=7
