# Shared configuration. Copy to .env and fill in.

# Postgres — your database connection (Neon in deployed environments)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
DATABASE_URL_POOLED=

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Transactional email. Without a key, login codes are written to the API log.
RESEND_API_KEY=
# Must be a verified Resend domain, or its shared onboarding sender.
RESEND_FROM=Trust Infrastructure <onboarding@resend.dev>

# HMAC key used to sign portable worker credential bundles (minimum 32 chars).
CREDENTIAL_SIGNING_SECRET=

# Shared compatibility key: development trust queries only.
# Production/history integrations use hashed per-platform keys (see docs/portable_work_history.md).
PLATFORM_API_KEY=

ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
REVIEW_USER_ATTEMPTS_PER_MINUTE=5
REVIEW_IP_ATTEMPTS_PER_MINUTE=30
REVIEW_DAILY_LIMIT=10

# For local development, put machine-specific overrides in .env.local, e.g.
#   DATABASE_URL=postgresql+asyncpg://you@localhost:5432/trust_dev

# Payscrow escrow. Without a key, a local stand-in holds job payments.
# Sandbox keys come from payscrow.dev; production is https://api.payscrow.net.
PAYSCROW_API_KEY=
PAYSCROW_BASE_URL=https://api.payscrow.dev
# Dashboard -> Access & API -> Webhook Signing Secret.
PAYSCROW_WEBHOOK_SECRET=
# Public HTTPS address of POST /api/v1/webhooks/payscrow (a tunnel locally).
PAYSCROW_WEBHOOK_URL=
# Share of Payscrow's charge the worker bears, 0-100 (0: the client pays it).
PAYSCROW_MERCHANT_CHARGE_PERCENTAGE=0
# Hours the customer has to release (code + rating) or report a problem after
# the worker marks the job complete. Then a dispute opens; money never releases
# on a timer.
ESCROW_CONFIRMATION_WINDOW_HOURS=48
# Base address of the screens, for links in emails.
FRONTEND_BASE_URL=http://localhost:3000
# Platform address told when a dispute opens or a platform asks to attest (optional).
OPS_EMAIL=
# The read-only worker behind the landing page's live demo.
DEMO_WORKER_EMAIL=demo.worker@example.com

# Micro-insurance premium: a share of the job between a floor and a cap, paid by
# the client on top of the job. Insurance is stubbed (SRS 7). 0 turns it off.
INSURANCE_PREMIUM_RATE=0.02
INSURANCE_PREMIUM_MIN=200
INSURANCE_PREMIUM_MAX=2000

# Independent, opt-in ownership import / onboarding rollout flags.
UNSIGNED_IMPORTS_ENABLED=false
ADDITIONAL_VERIFICATION_ENABLED=false
# Local private review attachments only; never used as a production fallback.
OWNERSHIP_STORAGE_DIR=
# Production review uploads use the existing private S3_BUCKET / AWS_* settings.
# Schedule: cd backend && python -m scripts.expire_review_evidence (hourly).
