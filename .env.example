# Shared Neon PostgreSQL connection string. Use the pooled connection string for runtime.
DATABASE_URL=postgresql+asyncpg://user:password@ep-example.neon.tech/trust_infrastructure?sslmode=require

# Local Redis exposed by docker compose.
REDIS_URL=redis://localhost:6379/0

# Backend
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
