# Shared configuration. Copy to .env and fill in.

# Postgres — your database connection (Neon in deployed environments)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
DATABASE_URL_POOLED=

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Transactional email. Without a key, login codes are written to the API log.
RESEND_API_KEY=
# Must be a verified Resend domain, or its shared onboarding sender.
RESEND_FROM=Trust Infrastructure <onboarding@resend.dev>

# HMAC key used to sign portable worker credential bundles (minimum 32 chars).
CREDENTIAL_SIGNING_SECRET=

# Shared compatibility key: development trust queries only.
# Production/history integrations use hashed per-platform keys (see docs/portable_work_history.md).
PLATFORM_API_KEY=

ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
REVIEW_USER_ATTEMPTS_PER_MINUTE=5
REVIEW_IP_ATTEMPTS_PER_MINUTE=30
REVIEW_DAILY_LIMIT=10

# For local development, put machine-specific overrides in .env.local, e.g.
#   DATABASE_URL=postgresql+asyncpg://you@localhost:5432/trust_dev

# Payscrow escrow. Without a key, a local stand-in holds job payments.
# Sandbox keys come from payscrow.dev; production is https://api.payscrow.net.
PAYSCROW_API_KEY=
PAYSCROW_BASE_URL=https://api.payscrow.dev
# Dashboard -> Access & API -> Webhook Signing Secret.
PAYSCROW_WEBHOOK_SECRET=
# Public HTTPS address of POST /api/v1/webhooks/payscrow (a tunnel locally).
PAYSCROW_WEBHOOK_URL=
# Share of Payscrow's charge the worker bears, 0-100 (0: the client pays it).
PAYSCROW_MERCHANT_CHARGE_PERCENTAGE=0
# Hours the customer has to release (code + rating) or report a problem after
# the worker marks the job complete. Then a dispute opens; money never releases
# on a timer.
ESCROW_CONFIRMATION_WINDOW_HOURS=48
# Base address of the screens, for links in emails.
FRONTEND_BASE_URL=http://localhost:3000
# Platform address told when a dispute opens (optional).
OPS_EMAIL=

# Micro-insurance premium: a share of the job between a floor and a cap, paid by
# the client on top of the job. Insurance is stubbed (SRS 7). 0 turns it off.
INSURANCE_PREMIUM_RATE=0.02
INSURANCE_PREMIUM_MIN=200
INSURANCE_PREMIUM_MAX=2000

# Revisioned, unscored history and request-specific contact verification.
HISTORY_ENABLED=true
# Stub reveals a sandbox code only in development; it never sends SMS.
# Production must configure Twilio Verify (Nigeria delivery testing required).
SMS_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional official N-ATLAS gateway; disabled until hosted and evaluated.
HISTORY_AI_ENABLED=false
HISTORY_AI_BASE_URL=
HISTORY_AI_API_KEY=
# Private spool shared by API and the separate history worker; never under public/.
HISTORY_AUDIO_DIR=
# Optional standalone gateway reads these from the process environment:
HISTORY_GATEWAY_KEY=
HF_TOKEN=

# Existing platform approval UI remains hidden in this focused pilot.
NEXT_PUBLIC_PLATFORM_APPROVALS_ENABLED=false

# Optional private translated speech gateway. Enable only validated voices.
HISTORY_SPEECH_PROVIDER=gateway
# For spitch: explicit JSON mapping; enable languages only after voice review.
HISTORY_SPEECH_VOICES=
HISTORY_SPEECH_ENABLED=false
HISTORY_SPEECH_BASE_URL=
HISTORY_SPEECH_API_KEY=
HISTORY_SPEECH_MODEL=
HISTORY_SPEECH_VERSION=
# Comma-separated language codes whose voices passed review: en,yo,ha,ig
HISTORY_SPEECH_LANGUAGES=

# Production deployment: managed same-origin frontend proxy (server-only shared secret).
INTERNAL_PROXY_SECRET=
API_PROXY_ORIGIN=
API_PROXY_HOSTPORT=
PROXY_TRUSTED_HOPS=0
RUN_HISTORY_WORKER=false
HISTORY_WORKER_HEARTBEAT=/tmp/trust-history-worker.heartbeat
# Production speech requires explicitly reviewed languages; candidate voices are not approval.
HISTORY_SPEECH_REVIEWED_LANGUAGES=
