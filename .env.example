# Shared configuration. Copy to .env and fill in.

# Postgres — your database connection (Neon in deployed environments)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
DATABASE_URL_POOLED=

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Transactional email. Without a key, login codes are written to the API log.
RESEND_API_KEY=
# Must be a verified Resend domain, or its shared onboarding sender.
RESEND_FROM=Trust Infrastructure <onboarding@resend.dev>

# HMAC key used to sign portable worker credential bundles (minimum 32 chars).
CREDENTIAL_SIGNING_SECRET=

# Shared compatibility key: development trust queries only.
# Production/history integrations use hashed per-platform keys (see docs/portable_work_history.md).
PLATFORM_API_KEY=

ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
REVIEW_USER_ATTEMPTS_PER_MINUTE=5
REVIEW_IP_ATTEMPTS_PER_MINUTE=30
REVIEW_DAILY_LIMIT=10

# For local development, put machine-specific overrides in .env.local, e.g.
#   DATABASE_URL=postgresql+asyncpg://you@localhost:5432/trust_dev

# Revisioned, unscored history and request-specific contact verification.
HISTORY_ENABLED=true
# Stub reveals a sandbox code only in development; it never sends SMS.
# Production must configure Twilio Verify (Nigeria delivery testing required).
SMS_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional official N-ATLAS gateway; disabled until hosted and evaluated.
HISTORY_AI_ENABLED=false
HISTORY_AI_BASE_URL=
HISTORY_AI_API_KEY=
# Private spool shared by API and the separate history worker; never under public/.
HISTORY_AUDIO_DIR=
# Optional standalone gateway reads these from the process environment:
HISTORY_GATEWAY_KEY=
HF_TOKEN=

# Existing platform approval UI remains hidden in this focused pilot.
NEXT_PUBLIC_PLATFORM_APPROVALS_ENABLED=false
